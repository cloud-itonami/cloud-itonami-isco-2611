;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a legal document intake, scanning and binding
;; robot performs case-file preparation, exhibit binding and physical
;; filing-room organization (ISCO 2611, lawyers). Its physical work:
;; shelving bound case-file binders, carrying trial boxes from the filing
;; room to the conference room, and keeping originals in a fire-resistive
;; filing cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-2611"
 :cases
 [{:id :case-binder-to-shelf
   :kind :manipulator
   :procedure "arm shelves a bound case-file binder from the binding station onto the filing-room shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.55 0.00] :to [0.25 0.70] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [1.0 2.0 3.0 4.5 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a light collaborative arm (~5 kg class)"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :trial-boxes-to-conference-room
   :kind :transport
   :procedure "AMR carries trial boxes of exhibits and case files from the filing room to the conference room"
   :params {:mass-kg 40.0 :distance-m 50.0 :v-max-mps 0.9 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 55.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.25}
   :sweep {:param :payload-kg :values [15.0 40.0 70.0 100.0 130.0]}
   :quantity :cycle-time-s
   :limit {:max 70.0 :basis "estimate: a box run within 70 s lets a full trial set move during a short recess"}
   :boundary {:lo 5.0 :hi 250.0}}
  {:id :fire-resistive-file-cabinet
   :kind :thermal
   :procedure "one-hour building fire acts on the insulated wall of the filing cabinet holding original documents"
   :params {:thickness-m 0.04 :conductivity-w-mk 0.20 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 927.0 :h-front-w-m2k 50.0 :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 3600.0 :nodes 21}
   :sweep {:param :h-front-w-m2k :values [15.0 25.0 50.0 80.0 120.0]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 (paper records): interior must not exceed 350 F (177 C) during the rated exposure; 927 C is the ASTM E119 furnace temperature at 60 min, held constant here (estimate: constant exposure, 40 mm insulation and its properties)"}
   :boundary {:lo 5.0 :hi 200.0}}]}
